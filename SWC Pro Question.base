views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("SWC Pro")
        - file.ext == "md"
    order:
      - done?
      - file.name
      - tags
      - test id
      - ques id
      - sr-due
    sort:
      - property: test id
        direction: ASC
      - property: ques id
        direction: ASC
    columnSize:
      file.name: 285
      note.tags: 417
      note.test id: 83
